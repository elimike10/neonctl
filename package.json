{
  "name": "neonctl",
  "version": "2.8.0",
  "description": "Neon CLI",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "neonctl": "./dist/cli.js"
  },
  "scripts": {
    "build": "npm run clean && tsc && cp src/*.html package*.json README.md ./dist",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "prepare": "npm run build"
  },
  "files": [
    "dist"
  ],
  "author": "Neon",
  "license": "Apache-2.0",
  "dependencies": {
    "@neondatabase/api-client": "^1.0.0",
    "axios": "^1.4.0",
    "axios-debug-log": "^1.0.0",
    "chalk": "^5.2.0",
    "cli-table3": "^0.6.3",
    "crypto-random-string": "^5.0.0",
    "default-browser": "^4.0.0",
    "env-paths": "^3.0.0",
    "execa": "^7.1.1",
    "find-up": "^6.3.0",
    "function-timeout": "^0.1.1",
    "handlebars": "^4.7.7",
    "js-yaml": "^4.1.0",
    "openid-client": "^5.4.2",
    "ora": "^6.3.1",
    "pg": "^8.11.0",
    "pg-connection-string": "^2.6.0",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.5",
    "@types/node": "^20.2.5",
    "@types/pg": "^8.10.1",
    "@types/yargs": "^17.0.24",
    "emocks": "^1.0.1",
    "prettier": "^2.8.8",
    "typescript": "^5.1.3",
    "vitest": "^0.31.4"
